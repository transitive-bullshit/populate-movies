{
  "name": "populate-movies",
  "version": "0.0.1",
  "private": true,
  "description": "Populates a full database of movies from TMDB and IMDB into Postgres.",
  "author": "Travis Fischer <travis@transitivebullsh.it>",
  "repository": "transitive-bullshit/populate-movies",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=16"
  },
  "scripts": {
    "build": "tsc",
    "clean": "del build",
    "prebuild": "run-s clean && prisma generate",
    "pretest": "run-s build",
    "prepare": "husky install",
    "pre-commit": "lint-staged",
    "test": "run-p test:*",
    "test:prettier": "prettier '**/*.{js,jsx,ts,tsx}' --check"
  },
  "dependencies": {
    "@keyv/redis": "^2.8.0",
    "@prisma/client": "^5.4.2",
    "cheerio": "1.0.0-rc.12",
    "csv-parse": "^5.5.2",
    "delay": "^6.0.0",
    "dequal": "^2.0.3",
    "dotenv": "^17.4.2",
    "global-agent": "^3.0.0",
    "got": "^15.0.5",
    "isobject": "^4.0.0",
    "json-diff": "^1.0.6",
    "keyv": "^4.5.4",
    "level": "^8.0.0",
    "lodash.omit": "^4.5.0",
    "lqip-modern": "^2.0.0",
    "make-dir": "^4.0.0",
    "minizlib": "^3.1.0",
    "movier": "^3.0.4",
    "p-map": "^7.0.4",
    "p-memoize": "^7.1.1",
    "p-throttle": "^5.1.0",
    "random": "^5.4.1",
    "wikibase-sdk": "^9.2.3"
  },
  "devDependencies": {
    "@fisch0920/config": "^1.4.1",
    "@types/lodash.omit": "^4.5.8",
    "@types/minizlib": "^2.1.7",
    "@types/node": "^25.9.1",
    "del-cli": "^5.1.0",
    "eslint": "^9.39.4",
    "husky": "^8.0.3",
    "lint-staged": "^15.0.2",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.8.3",
    "prisma": "^5.4.2",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3"
  },
  "prettier": "@fisch0920/config/prettier",
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --ignore-unknown --write",
      "eslint --cache --fix"
    ]
  }
}
